      "query_support": "query_only",
      "description": "Returns instrument identity, e.g. JOY-IT,JDS6600-LITE,12345,N/A or FeelElec,FY6900-20M,12345,N/A."
    },
    {
      "command_id": "starrst",
      "name": "Reset",
      "scpi_pattern": "*RST",
      "operation_kind": "action",
      "query_pattern": null,
      "query_support": "none",
      "description": "Safe reset: outputs off, sine, 1 kHz, 1 Vpp, 0 V offset, duty 50 %, phase 0."
    },
    {
      "command_id": "starcls",
      "name": "Clear status",
      "scpi_pattern": "*CLS",
      "operation_kind": "action",
      "query_pattern": null,
      "query_support": "none",
      "description": "Clears the error queue."
    },
