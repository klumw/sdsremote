    "source_channel": {
      "placeholder": "<n>",
      "allowed_values": [
        1,
        2
      ]
    },
    "units_optional": true,
    "unit_case_insensitive": true,
    "unit_rules": {
      "FREQ": {
        "accepted": [
          "HZ",
          "KHZ",
          "MHZ"
        ],
        "default": "Hz"
      },
      "VOLT_and_OFFS": {
        "accepted": [
          "V",
          "VPP",
          "MV"
        ],
        "default": "V"
      },
      "DCYC": {
        "accepted": [
          "%",
          "PCT"
        ],
        "default": "%"
      },
      "PHAS": {
        "accepted": [
          "DEG",
          "DEGREE"
        ],
        "default": "degrees"
      }
    },
    "header_aliases": {
      "SOURCE": "SOUR",
      "OUTPUT": "OUTP",
      "VOLTAGE": "VOLT",
      "OFFSET": "OFFS",
      "FUNCTION": "FUNC",
      "DCYCLE": "DCYC",
      "PHASE": "PHAS",
      "STATE": "STAT",
      "FREQUENCY": "FREQ"
    },
    "header_alias_notes": "Whole header segments may use the aliases above. SQUARE and PULSE are not header aliases; use SQU and PULS."
